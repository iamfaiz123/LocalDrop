<?xml version="1.0" encoding="utf-8"?>
<!-- LocalDrop talks to other phones on the local network over plain HTTP
     (there is no internet or certificate authority on a hotspot). Cleartext is
     permitted for that purpose; the app never contacts internet hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
